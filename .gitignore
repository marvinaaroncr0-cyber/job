__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments (Crucial to ignore)
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# FastAPI / Uvicorn / Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ==============================================================================
# ⚛️ REACT SPECIFIC
# ==============================================================================
# Dependencies
node_modules/
/jspm_packages/

# Production build outputs (Vite, Create React App, etc.)
dist/
build/
.next/
out/

# Frontend testing & logs
coverage/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================================================================
# 🔐 SECRETS & ENVIRONMENT VARIABLES (NEVER COMMIT THESE)
# ==============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ==============================================================================
# 💻 SYSTEM & IDE FILES
# ==============================================================================
# Operating System files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# JetBrains IDEs (PyCharm, WebStorm)
.idea/

# VS Code
.vscode/
!.vscode/extensions.json

# Local history / crash logs
.history/
*.log
